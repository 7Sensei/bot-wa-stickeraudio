# ===================================================
# KONFIGURASI BOT WHATSAPP STIKER & AUDIO (TERMUX)
# ===================================================

# Nomor WhatsApp Bot (wajib diawali kode negara, contoh 62 untuk Indonesia tanpa tanda + atau spasi)
# Contoh: 6281234567890
BOT_PHONE_NUMBER=6281234567890

# Prefix perintah bot (default: .)
BOT_PREFIX=.

# Batasan Ukuran Media (dalam Megabyte / MB)
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=15
MAX_AUDIO_SIZE_MB=25

# Batasan Durasi Video untuk Stiker Animasi (dalam detik, maksimal 10 detik untuk WA)
MAX_STICKER_VIDEO_DURATION_SEC=10

# Metadata Stiker WhatsApp (Pack Name & Author)
STICKER_PACK_NAME=Bot Stiker Termux
STICKER_AUTHOR_NAME=Antigravity

# Lokasi Folder Sesi dan File Sementara
AUTH_DIR=auth
TEMP_DIR=temp

# Level Logging Pino (info | debug | warn | error | silent)
LOG_LEVEL=info
